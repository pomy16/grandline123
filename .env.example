NODE_ENV=development

# Ports
API_PORT=4000
WEB_PORT=3000

# Database and queue
DATABASE_URL=postgresql://tcg_monitor:tcg_monitor@localhost:5432/tcg_monitor?schema=public
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Discord webhooks
DISCORD_DEFAULT_WEBHOOK_URL=https://discord.com/api/webhooks/replace/default
DISCORD_POKEMON_WEBHOOK_URL=
DISCORD_ONE_PIECE_WEBHOOK_URL=
DISCORD_HIGH_PRIORITY_WEBHOOK_URL=
DISCORD_ERROR_WEBHOOK_URL=

# Monitoring safety defaults
DEFAULT_POLLING_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_MS=10000
MAX_RETRIES=3
RATE_LIMIT_REQUESTS_PER_MINUTE=30

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
